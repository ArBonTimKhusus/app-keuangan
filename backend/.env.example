# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=arbonkas_user
DB_PASSWORD=your_secure_password_here
DB_NAME=arbonkas_db

# JWT Configuration
JWT_SECRET=your_very_long_random_secret_key_min_32_characters
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com
# For multiple origins, use comma-separated: https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Security
BCRYPT_SALT_ROUNDS=12

# Session
SESSION_EXPIRY_DAYS=7
